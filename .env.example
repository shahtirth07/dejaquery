# Copy to .env and fill in values. Never commit .env.

# OpenAI — leave blank to use the offline SQL mock on the cold path
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Memory backend: "everos" (HTTP server) or "local" (offline embeddings)
MEMORY_BACKEND=everos

# Déjà Query HTTP bind
APP_HOST=127.0.0.1
APP_PORT=8000

# EverOS HTTP bind (must differ from APP_PORT)
EVEROS_HOST=127.0.0.1
EVEROS_PORT=8100
# Optional override; run_local.sh builds this from host/port if unset
# EVEROS_URL=http://127.0.0.1:8100
EVEROS_ROOT=
EVEROS_USER_ID=dejaquery
EVEROS_CONFIDENCE_THRESHOLD=0.70

# Optional: EverOS LLM overrides (defaults to OPENAI_API_KEY / OpenAI base URL)
# EVEROS_LLM__API_KEY=
# EVEROS_LLM__BASE_URL=https://api.openai.com/v1
# EVEROS_LLM__MODEL=gpt-4o-mini
